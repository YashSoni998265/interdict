# Copy to .env and fill in. Never commit .env (it is git-ignored).

# FalkorDB connection (local Docker Compose stack)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=choose-a-local-password

# FalkorDB server limits (passed to the module at startup)
FALKORDB_TIMEOUT_DEFAULT_MS=1000
FALKORDB_TIMEOUT_MAX_MS=30000
FALKORDB_RESULTSET_SIZE=100000
FALKORDB_BROWSER=0

# Per-query timeout used by the engine (solution.md NFR-14)
QUERY_TIMEOUT_MS=500

# API and MCP processes (generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
INTERDICT_SESSION_SECRET=
INTERDICT_INTERNAL_TOKEN=
INTERDICT_MCP_URL=http://127.0.0.1:8765/mcp
INTERDICT_ALLOWED_ORIGINS=http://localhost:5173
INTERDICT_COOKIE_SECURE=0

# Claude agent (optional; without a key the deterministic fallback runs the same tools)
ANTHROPIC_API_KEY=
INTERDICT_LLM_MODEL=claude-opus-5-5

# Public deployment (deploy/docker-compose.prod.yml)
INTERDICT_DOMAIN=
LLM_DAILY_BUDGET_USD=10
