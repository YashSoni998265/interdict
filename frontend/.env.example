# Copy to .env.local to override. All values are public build-time settings (no secrets).

# mock (default): serve the recorded engine fixtures in the browser, no backend needed.
# http: call the real API (session cookie + CSRF token, SSE for investigations).
VITE_API_MODE=mock

# Base URL of the API in http mode. Empty means same origin (the API serves the built app).
VITE_API_BASE=

# Development only: the Vite dev server proxies /api to this local API (http mode).
# VITE_DEV_API_PROXY=http://127.0.0.1:8000
